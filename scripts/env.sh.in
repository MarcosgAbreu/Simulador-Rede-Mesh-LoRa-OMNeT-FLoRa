#!/usr/bin/env bash
export LORA_MESH_ROOT="@PROJECT_ROOT@"
export OMNETPP_ROOT="@OMNETPP_ROOT@"
export INET_ROOT="@INET_ROOT@"
export FLORA_ROOT="@FLORA_ROOT@"
export VIRTUAL_ENV="${LORA_MESH_ROOT}/.venv"
export PATH="${VIRTUAL_ENV}/bin:${OMNETPP_ROOT}/bin:${PATH}"
export LD_LIBRARY_PATH="${OMNETPP_ROOT}/lib:${INET_ROOT}/src:${FLORA_ROOT}/src:${LD_LIBRARY_PATH:-}"
export PYTHONPATH="${LORA_MESH_ROOT}/src:${PYTHONPATH:-}"
